{% if site.climber_name %}
  <!-- Mountaineer that climbs the name heading -->
  <style>
    #climber-name {
      position: relative;
      display: inline-block;
    }
    #climber-name .climber {
      position: absolute;
      top: 0;
      left: 0;
      pointer-events: none;
      opacity: 0;
      offset-rotate: 0deg;
      offset-anchor: 50% 100%;
      offset-distance: 0%;
      transition: opacity 0.25s ease;
      color: var(--global-text-color);
      overflow: visible;
      z-index: 1;
    }
    #climber-name .climber.is-climbing {
      opacity: 1;
    }
    .climber .climber-axe-arm {
      transform-box: view-box;
      transform-origin: 22px 19px;
      animation: climberAxeSwing 0.7s ease-in-out infinite;
    }
    @keyframes climberAxeSwing {
      0%,
      100% {
        transform: rotate(-7deg);
      }
      50% {
        transform: rotate(9deg);
      }
    }
  </style>
  <script defer src="{{ '/assets/js/climber.js' | relative_url | bust_file_cache }}"></script>
{% endif %}
